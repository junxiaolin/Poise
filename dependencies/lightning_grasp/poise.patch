new file mode 100644
index 0000000..f49a77a
--- /dev/null
+++ b/lygra/urdf_utils.py
@@ -0,0 +1,143 @@
+import hashlib
+import json
+import os
+import tempfile
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+
+PACKAGE_URI_PREFIX = "package://"
+RESOLVER_VERSION = b"2"
+
+
+def _resolve_package_uri(uri, urdf_path):
+    package_path = uri[len(PACKAGE_URI_PREFIX):]
+    package_name, separator, relative_path = package_path.partition("/")
+    if not separator or not package_name or not relative_path:
+        raise ValueError(f"Invalid URDF package URI: {uri}")
+
+    relative = Path(relative_path)
+    if relative.is_absolute() or ".." in relative.parts:
+        raise ValueError(f"Unsafe URDF package URI: {uri}")
+
+    urdf_dir = urdf_path.parent
+    candidates = []
+    for ancestor in (urdf_dir, *urdf_dir.parents):
+        if ancestor.name == package_name:
+            candidates.append(ancestor / relative)
+        candidates.append(ancestor / package_name / relative)
+
+    for candidate in candidates:
+        if candidate.is_file():
+            return candidate.resolve()
+
+    raise FileNotFoundError(
+        f"Could not resolve {uri!r} referenced by {urdf_path}. "
+        f"Expected package {package_name!r} near the URDF."
+    )
+
+
+def resolve_urdf_package_uris(urdf_path):
+    """Return a URDF path whose package:// resources are absolute paths."""
+    source_path = Path(urdf_path).expanduser().resolve()
+    if not source_path.is_file():
+        raise FileNotFoundError(f"URDF does not exist: {source_path}")
+
+    source_bytes = source_path.read_bytes()
+    if PACKAGE_URI_PREFIX.encode() not in source_bytes:
+        return source_path.as_posix()
+
+    root = ET.fromstring(source_bytes)
+    changed = False
+    for element in root.iter():
+        for attribute in ("filename", "url"):
+            value = element.attrib.get(attribute)
+            if value and value.startswith(PACKAGE_URI_PREFIX):
+                element.set(
+                    attribute,
+                    _resolve_package_uri(value, source_path).as_posix(),
+                )
+                changed = True
+
+    for joint in root.findall("joint"):
+        if joint.attrib.get("type") != "fixed":
+            continue
+        axis = joint.find("axis")
+        if axis is not None and axis.attrib.get("xyz") == "0 0 0":
+            axis.set("xyz", "0 0 1")
+            changed = True
+
+    if not changed:
+        return source_path.as_posix()
+
+    digest = hashlib.sha256(RESOLVER_VERSION + source_bytes).hexdigest()[:16]
+    cache_dir = Path(tempfile.gettempdir()) / "lightning_grasp_resolved_urdf"
+    cache_dir.mkdir(parents=True, exist_ok=True)
+    resolved_path = cache_dir / f"{source_path.stem}-{digest}.urdf"
+
+    if not resolved_path.exists():
+        temporary_path = resolved_path.with_suffix(f".{os.getpid()}.tmp")
+        ET.ElementTree(root).write(
+            temporary_path,
+            encoding="utf-8",
+            xml_declaration=True,
+        )
+        os.replace(temporary_path, resolved_path)
+
+    return resolved_path.as_posix()
+
+
+def override_urdf_joint_limits(urdf_path, joint_limits, profile_name):
+    """Return a cached URDF with the requested revolute joint limits."""
+    resolved_source = Path(resolve_urdf_package_uris(urdf_path))
+    source_bytes = resolved_source.read_bytes()
+    root = ET.fromstring(source_bytes)
+    joints = {
+        joint.attrib["name"]: joint
+        for joint in root.findall("joint")
+        if "name" in joint.attrib
+    }
+
+    missing = sorted(set(joint_limits) - set(joints))
+    if missing:
+        raise ValueError(
+            f"Joint-limit profile {profile_name!r} contains unknown joints: {missing}"
+        )
+
+    for joint_name, (lower, upper) in joint_limits.items():
+        if lower > upper:
+            raise ValueError(
+                f"Invalid limits for {joint_name}: lower {lower} > upper {upper}"
+            )
+        limit = joints[joint_name].find("limit")
+        if limit is None:
+            raise ValueError(f"Joint {joint_name!r} has no <limit> element")
+        limit.set("lower", f"{lower:.10g}")
+        limit.set("upper", f"{upper:.10g}")
+
+    profile_bytes = json.dumps(
+        {
+            name: [float(bounds[0]), float(bounds[1])]
+            for name, bounds in sorted(joint_limits.items())
+        },
+        sort_keys=True,
+    ).encode()
+    digest = hashlib.sha256(
+        RESOLVER_VERSION + source_bytes + profile_name.encode() + profile_bytes
+    ).hexdigest()[:16]
+    cache_dir = Path(tempfile.gettempdir()) / "lightning_grasp_resolved_urdf"
+    cache_dir.mkdir(parents=True, exist_ok=True)
